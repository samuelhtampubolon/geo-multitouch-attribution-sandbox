# Environment Configuration (copy to .env; never commit real secrets)
APP_ENV=development
APP_DEBUG=false

# Network Binding
HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501

# Database (SQLite / PostgreSQL)
DATABASE_URL=sqlite:///data/geo_mta.db

# Security & OWASP Hardening
# Required in production (>= 32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty in development to get a random per-process key.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
# Tenant client credentials used by POST /api/v1/auth/token, format tenant:secret,tenant2:secret2
# Required in production (>= 16 chars each). Development defaults to a demo secret for tenant-alpha.
TENANT_CLIENT_SECRETS=
# Comma-separated CORS allow-list (no wildcard)
CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501

# Rate Limiting
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
