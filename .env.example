# Environment Configuration
APP_ENV=development
APP_DEBUG=true

# Network Binding
HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501

# Database (SQLite / PostgreSQL)
DATABASE_URL=sqlite:///data/geo_mta.db

# Security & OWASP Hardening
JWT_SECRET=super-secret-geo-mta-attributions-key-2026-owasp
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
DEFAULT_TENANT_ID=tenant-alpha

# Rate Limiting
RATE_LIMIT_DEFAULT=120/minute
